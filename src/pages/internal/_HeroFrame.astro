---
/**
 * The homepage's hero, as the homepage itself: `/` in a frame one window tall, so what shows is the
 * first screen a visitor gets at this window's size.
 *
 * A frame rather than a restatement, because the hero is the one section that is mostly the PAGE's
 * styling: the fixed header and its scrim, `--home-header-h`, the purple primary, the hero note and
 * the fold budget are all `index.astro`'s global rules, not `Hero`'s. A copy of those would be a
 * second homepage to keep in step. In a frame there is nothing to keep in step — the shipping
 * direction IS the homepage, and a candidate differs from it only by what it swaps in.
 *
 * A candidate's video and still are swapped into the framed page's `#hero .video-cover` as soon as
 * the parser reaches it — well before the hero's own loader, which waits for `load`, reads them.
 * The homepage's own files are never requested for the panel; its LCP preload of `tb-cover.webp`
 * still is, which the page's head asks for before anything here can intervene.
 *
 * Phones get the still only, as on the homepage: the hero withholds the video below 768.
 */
interface Props {
	/** A candidate's media in place of the homepage's. Omitted means the homepage as it ships. */
	video?: { webm: string; mp4: string; poster: string };
}

const { video } = Astro.props;
---

<div class="heroframe">
	{
		/* `data-page`, not `src`: every direction's frame is in the document at once, and a hidden
		   iframe is not held back by `loading="lazy"`. Only the one scrolled near gets its page. */
	}
	<iframe
		class="heroframe__page"
		data-heroframe
		data-page="/"
		data-webm={video?.webm}
		data-mp4={video?.mp4}
		data-poster={video?.poster}
		title={video ? 'The homepage with a candidate hero video' : 'The homepage as it ships'}></iframe>
</div>

<style lang="scss">
	// One window tall: the hero sizes itself against the viewport's height (its fold budget), so the
	// frame has to hand it the height a visitor would have.
	.heroframe__page {
		display: block;
		width: 100%;
		height: 100vh;
		border: 0;
		background: #000;
	}
</style>

<script>
	/** Rewrites the framed page's hero panel the moment the parser has produced it. */
	const swapIn = (frame: HTMLIFrameElement) => {
		const { webm, mp4, poster } = frame.dataset;
		const deadline = performance.now() + 30000;
		const tick = () => {
			const doc = frame.contentDocument;
			const cover = doc && doc.URL !== 'about:blank' ? doc.querySelector<HTMLElement>('#hero .video-cover') : null;
			if (!cover) {
				if (performance.now() < deadline) setTimeout(tick, 4);
				return;
			}
			if (webm) cover.dataset.videoWebm = webm;
			if (mp4) cover.dataset.videoMp4 = mp4;
			if (poster) cover.style.setProperty('--hero-bg', `url('${poster}')`);
		};
		tick();
	};

	const io = new IntersectionObserver(
		(entries, obs) => {
			entries.forEach((entry) => {
				if (!entry.isIntersecting) return;
				const frame = entry.target as HTMLIFrameElement;
				obs.unobserve(frame);
				frame.src = frame.dataset.page!;
				if (frame.dataset.webm || frame.dataset.mp4 || frame.dataset.poster) swapIn(frame);
			});
		},
		{ rootMargin: '200px' }
	);

	document.querySelectorAll<HTMLIFrameElement>('iframe[data-heroframe]').forEach((f) => io.observe(f));
</script>
