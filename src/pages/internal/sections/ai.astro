---
import VisualPage from '@root/pages/internal/_VisualPage.astro';
import Variant from '@root/pages/internal/_Variant.astro';
import AiSection from '@components/Landing/AiSection.astro';
import AiTwoUp from '@components/Landing/AiTwoUp.astro';
import AiWide from '@components/Landing/AiWide.astro';
import { kv } from '@root/pages/internal/_key-visuals';
import { AI_BADGE_CYCLE_HANDOFF } from '@data/ai-visual';

/**
 * The AI section — "Build IoT solutions faster than ever with AI inside ThingsBoard".
 *
 * A SECTION rather than a row: it carries its own header and two full-bleed bands, so every direction
 * here is a `bleed` Variant. The desktop view is the section edge to edge at this window's width, as
 * `index.astro` places it; the phone view frames it at 375, so its viewport queries fire against a
 * real phone viewport rather than a narrow box.
 *
 * ORDER: the SHIPPING `AiSection` first, then candidates newest first, then the previous homepage last.
 * ADD a candidate under the shipping one, as a component beside `AiSection`, never as an edit to it.
 * A candidate that differs by one setting can instead be a prop on `AiSection` whose default is
 * today's behaviour, passed here through `props` — and it then FOLLOWS the shipping section, taking
 * whatever is promoted into it later.
 *
 * A REFERENCE (a previous homepage) must pin EVERY prop it depends on, not just the one it differs
 * by, or the next promotion changes it too: `bands` pins `terminal: 'cli'`, because the 2026-09-24
 * promotion made the agent terminal the default and it silently took it.
 *
 * PROMOTED 2026-09-27 to orders A and B, with `wash: 'cycle'`: `AiWide` (a candidate from
 * 2026-09-26), a component beside `AiSection` — the switcher with a 600px window beside smaller copy
 * that ends on a call to action; both windows whole and squarer, the chat's bar a plain label, the
 * terminal at 14px printing the ThingsBoard wordmark, then its status, then the
 * session. `wash: 'cycle'` is the same section with the band following the mark's colours.
 *
 * CANDIDATE 2026-09-26: `AiTwoUp`, a component beside `AiSection` — both routes side by side under one
 * band, each window over its copy, the band washed from its corners in the two routes' hues.
 *
 * PROMOTED 2026-09-23: the toggle with the hand-off, now `AiSection`'s default and the homepage's.
 * The plain-fade toggle was retired and deleted with it. `layout="bands"` is the page that came
 * before, kept as the reference.
 *
 * PROMOTED 2026-09-24, later: the freezer-door chat and windows that fill their column, judged here
 * together as one direction and folded into `AiSection` as `chat` and `fit` defaults. The page before
 * them is `fit="inset"` + `chat="dewPoint"`, kept beside the reference; `bands` pins both as well.
 *
 * PROMOTED 2026-09-24: the coding-agent terminal, judged here as `AiSectionNext` (a full copy, so its
 * content could change the sizing) and folded back into `AiSection` as the default. The shell
 * terminal it replaced is `terminal="cli"`; its own variant was retired, as it matched the shipping
 * section until the second tab was picked, and `bands` still shows it.
 *
 * PROMOTED 2026-09-26, with running order A: an action under each route's copy (`cta`), now the
 * default. The handoff's section without them is "No actions"; the two older references pin
 * `cta: false` too, and the two candidates follow the shipping section and show the actions.
 *
 * PROMOTED 2026-09-26, later: the wash follows the mark (`wash: 'cycle'`, this page's "Wash follows
 * mark" until now, so that variant went — it was the shipping section) and one call to action under
 * the row (`cta: 'block'`). The morning's action per route is the candidate "Action per route". The
 * references now pin `wash: 'route'` and `cta: 'none'`, and "Value copy" pins `wash: 'route'`: its
 * kickers are set in the route's hue, which a cycling wash would put on the wrong ground.
 *
 * LATER STILL: the default mark cycle gained the use cases' berry, and the cycling wash became a glow.
 * The references pin `hues: AI_BADGE_CYCLE_HANDOFF`, the handoff's five colours.
 */
---

<VisualPage visual="ai">
	<Variant
		visual={kv('ai')}
		component={AiWide}
		props={{ wash: 'cycle' }}
		bleed
		shipping
		name="Wide window · cycling wash"
		note="Promoted 2026-09-27 to running orders A and B · the Wide window with the band's wash following the section's mark through the page's section colours, on the mark's clock"
	/>

	<Variant
		visual={kv('ai')}
		component={AiWide}
		bleed
		name="Wide window"
		note="candidate · the switcher with the window at 600 of the 960 measure; both windows whole and squarer, the chat's bar a plain label, the terminal at 14px opening on the ThingsBoard wordmark, its status under it, then the session; smaller headings, no kickers, and a call to action under each route's copy"
	/>

	<Variant
		visual={kv('ai')}
		component={AiTwoUp}
		bleed
		name="Two-up"
		note="candidate · both routes side by side under one band, each window over its copy; the wash rises from the band's corners, green on the chat's side and violet on the terminal's"
	/>

	<Variant
		visual={kv('ai')}
		component={AiSection}
		props={{ cta: 'block', wash: 'cycle' }}
		bleed
		name="Toggle"
		note="previous homepage (A and B, 2026-09-26 to 09-27; the handoff's section still) · the toggle with the hand-off, the wash following the mark and a call to action band under the row"
	/>

	<Variant
		visual={kv('ai')}
		component={AiSection}
		props={{ cta: 'route' }}
		bleed
		name="Action per route"
		note="candidate (2026-09-26, the morning's A) · a button at the end of each route's copy instead of the block under the row"
	/>

	<Variant
		visual={kv('ai')}
		component={AiSection}
		props={{ copy: 'value', wash: 'route' }}
		bleed
		name="Value copy"
		note="candidate · a kicker naming the tool, and headlines that say what you get; on the route's wash, since its kickers take the route's hue"
	/>

	<Variant
		visual={kv('ai')}
		component={AiSection}
		props={{ cta: 'none', wash: 'route', hues: AI_BADGE_CYCLE_HANDOFF }}
		bleed
		name="No actions"
		note="previous homepage (the handoff, 2026-09-25) · the shipping section with no action under either route"
	/>

	<Variant
		visual={kv('ai')}
		component={AiSection}
		props={{ fit: 'inset', chat: 'dewPoint', cta: 'none', wash: 'route', hues: AI_BADGE_CYCLE_HANDOFF }}
		bleed
		name="Inset windows"
		note="previous homepage (2026-09-24, before the chat and the fit were promoted) · both windows 500 wide and centred in their column; the dew-point chat"
	/>

	<Variant
		visual={kv('ai')}
		component={AiSection}
		props={{
			layout: 'bands',
			terminal: 'cli',
			chat: 'dewPoint',
			fit: 'inset',
			cta: 'none',
			wash: 'route',
			hues: AI_BADGE_CYCLE_HANDOFF,
		}}
		bleed
		name="Bands"
		note="previous homepage · both routes stacked, with the lede, the kickers and the shell terminal"
	/>
</VisualPage>

{/* The homepage's context the section is drawn against: `_bleed-context.scss`. */}
<style lang="scss" is:global>
	@use '../bleed-context';
</style>
