---
import { defaultCustomersLogos, type CustomerLogo } from '../../data/customersLogo';

interface Props {
	/**
	 * Product tag for styling: 'ce' | 'pe' | 'paas' | 'edge' | etc.
	 */
	productTag?: string;
	/**
	 * Custom logos array. If not provided, uses default logos.
	 */
	logos?: CustomerLogo[];
	/**
	 * Renders the row as a full-width dark strip. Used directly under the
	 * homepage hero, where it closes the hero rather than opening the content.
	 */
	onDark?: boolean;
}

const { productTag = 'ce', logos = defaultCustomersLogos, onDark = false } = Astro.props;

const filterMap: Record<string, string> = {
	ce: 'invert(86%) sepia(5%) saturate(530%) hue-rotate(171deg) brightness(237%) contrast(86%)',
	pe: 'invert(79%) sepia(25%) saturate(246%) hue-rotate(93deg) brightness(185%) contrast(82%)',
	paas: 'invert(87%) sepia(3%) saturate(664%) hue-rotate(176deg) brightness(237%) contrast(82%)',
	edge: 'invert(79%) sepia(25%) saturate(246%) hue-rotate(130deg) brightness(185%) contrast(82%)',
};
// On the dark strip the per-product tints land on light grey, not white.
// `brightness(0)` flattens each mark to black, `invert(1)` takes it to pure white.
const imgFilter = onDark ? 'brightness(0) invert(1)' : (filterMap[productTag] ?? '');

const LOCAL_PREFIX = '/src/assets/images/';
const svgUrls = import.meta.glob<string>('/src/assets/images/**/*.svg', {
	query: '?url',
	import: 'default',
});

const resolvedLogos = await Promise.all(
	logos.map(async (logo) => {
		if (logo.src.startsWith(LOCAL_PREFIX)) {
			const loader = svgUrls[logo.src];
			return { ...logo, src: loader ? await loader() : logo.src };
		}
		return logo;
	})
);

// OPTICAL SIZING, from each logo's own box and nothing else. The marks run from 2.6:1
// (Intel) to 6:1 (T-Mobile), so one shared height gave the wide ones more than twice
// the area, and so the weight, of the compact ones. Each mark instead takes a factor `k`
// on a shared reference height: the square root of its aspect ratio against 4:1, which
// gives every mark the same area as a 4:1 mark of that height. It needs only the width
// and height every entry already carries, so a new logo is balanced on arrival.
//
// `units` is the mark's width in reference heights. Their sum is the whole row's width
// per pixel of reference height, which is what lets the CSS fit the row to its container
// without knowing which logos are in it; the narrowest and widest set the size limits.
const REF_RATIO = 4;
const sizedLogos = resolvedLogos.map((logo) => {
	const ratio = logo.width / logo.height;
	const k = Math.sqrt(REF_RATIO / ratio);
	return { ...logo, k, units: k * ratio };
});
const rowUnits = sizedLogos.reduce((sum, logo) => sum + logo.units, 0);
const rowVars = [
	`--logo-count: ${sizedLogos.length}`,
	`--logo-units: ${rowUnits.toFixed(3)}`,
	`--logo-units-min: ${Math.min(...sizedLogos.map((logo) => logo.units)).toFixed(3)}`,
	`--logo-units-max: ${Math.max(...sizedLogos.map((logo) => logo.units)).toFixed(3)}`,
].join('; ');
---

<section
	id="tb-customers"
	class:list={['customers-logo', onDark && 'customers-logo--dark']}
	style={rowVars}
	data-logo-strip
>
	<div class="customers-logo__content">
		<div class="customers-logo__track">
			{
				/* Rendered twice so the loop can run seamlessly: the track slides by exactly one
				   set and starts over. The copy is only displayed while the loop runs, and it is
				   `inert` and `aria-hidden`, so a screen reader or a keyboard meets each logo once. */
				[false, true].map((isCopy) => (
					<div class="customers-logo__set" aria-hidden={isCopy ? 'true' : undefined} inert={isCopy ? true : undefined}>
						{sizedLogos.map((logo) => (
							<a href={logo.href} class="customers-logo__item" style={`--k: ${logo.k.toFixed(4)}`}>
								<img
									src={logo.src}
									alt={logo.ariaLabel}
									width={logo.width}
									height={logo.height}
									style={imgFilter ? `filter:${imgFilter}` : undefined}
								/>
							</a>
						))}
					</div>
				))
			}
		</div>
	</div>
</section>

<style lang="scss">
	@use '../../styles/variables' as *;

	// ONE ROW, SIZED BY ONE NUMBER.
	//
	// Every mark is `--k` (see the frontmatter) times a shared reference height, `--h0`,
	// so the row scales as one and stays balanced at every size. `--h0` is the height that
	// fits the row to its container with `--logo-gap-fit` between marks, held between two
	// limits stated as the WIDTHS a reader sees:
	//
	//   floor    the narrowest mark is never under `--mark-min-w`, so nothing renders as
	//            a smudge;
	//   ceiling  the widest mark is never over `--mark-max-w`, so a big screen does not
	//            blow the strip up into a billboard.
	//
	// The spacing is even ALL the way across, the two ends included: the first and last
	// marks keep a full gap of room inside the row's padding, so at no width does a mark
	// sit on the hero's own edge. Above the ceiling the marks stop growing and the spare
	// room goes into those gaps, evenly. Below the floor they stop shrinking and the row
	// no longer fits, and then it loops (see THE LOOP). All of it comes from the logo set
	// itself, so adding or removing a logo needs no retuning here.
	.customers-logo {
		--mark-min-w: 64px;
		--mark-max-w: 150px;
		--logo-gap-min: 24px;
		--logo-gap-fit: 40px;
		--ribbon-pad: clamp(20px, calc(0.5rem + 2vw), 56px);

		position: relative;
		max-width: 1800px;
		margin: 0 auto;
		padding-block: clamp(24px, 2.5vw, 36px);

		&__content {
			// The query container for `cqi` below: the row's own width, less its padding.
			container-type: inline-size;
			max-width: calc(960px + var(--ribbon-pad) * 2);
			margin: 0 auto;
			padding-inline: var(--ribbon-pad);

			// Never wrapped: two rows hold the floor only from ~390px, so a 360 or 375
			// phone would get three, and a wrapped row is taller than the strip it is in.
			// One line and one height, looping when it does not fit (below) and swipeable
			// where the loop is off: reduced motion, or no script.
			overflow-x: auto;
			overscroll-behavior-x: contain;
			scroll-snap-type: x proximity;
			scroll-padding-inline: var(--ribbon-pad);
			// No bar at any width. On touch it was already overlay-only; with a mouse it
			// only ever showed in a window under ~700px, as a grey rule under a strip of
			// white marks, and a trackpad, Shift+wheel or Tab still get across.
			scrollbar-width: none;

			&::-webkit-scrollbar {
				display: none;
			}

			// The fades sit over the padding alone, so while the row fits they cover
			// nothing. Once it overflows, the marks pass under them at both ends and the
			// one at the edge fades out rather than being sliced — a slice is what made an
			// earlier scroller here read as broken rather than scrollable.
			--fade-mask: linear-gradient(
				to right,
				transparent,
				#000 var(--ribbon-pad),
				#000 calc(100% - var(--ribbon-pad)),
				transparent
			);
			-webkit-mask-image: var(--fade-mask);
			mask-image: var(--fade-mask);
		}

		// At least the row's width, so the one visible set can spread across it; wider
		// once the loop shows the copy beside it.
		&__track {
			display: flex;
			gap: var(--logo-gap-min);
			width: max-content;
			min-width: 100%;
		}

		&__set {
			display: flex;
			flex: 1 0 auto;
			align-items: center;
			// Even spacing between the marks AND at the two ends: the padding is a gap's
			// worth, so the end slots start level with the inner ones and `space-evenly`
			// then grows every slot alike. When the row does not fit, the free space is
			// negative and the safe fallback packs the marks from the start instead.
			justify-content: space-evenly;
			gap: var(--logo-gap-min);
			padding-inline: var(--logo-gap-min);

			&[aria-hidden='true'] {
				display: none;
			}
		}

		&__item {
			display: block;
			flex: 0 0 auto;
			scroll-snap-align: start;

			// `cqi`, not `vw`: the fit is to the row's own width, so it holds under any
			// padding and at any cap.
			--h0: clamp(
				var(--mark-min-w) / var(--logo-units-min),
				(100cqi - (var(--logo-count) + 1) * var(--logo-gap-fit)) / var(--logo-units),
				var(--mark-max-w) / var(--logo-units-max)
			);
		}

		img {
			display: block;
			height: calc(var(--h0) * var(--k, 1));
			width: auto;
		}

		// ── THE LOOP ────────────────────────────────────────────────────────────────────
		//
		// Where the row does not fit (a phone, a narrow window) it slides by one set at a
		// constant speed and starts over, so every visitor sees all the marks without
		// having to swipe for them. The script below sets `data-marquee` only then, and
		// never under reduced motion; it also sets the distance and the duration from the
		// set's measured width, so the speed is the same whatever the logos.
		//
		// Slow, and it stops for anyone reading it: a pointer over it, a finger on it, a
		// logo in keyboard focus. It also stops while off screen. There is deliberately no
		// pause button; reduced motion turns the loop off entirely.
		&[data-marquee] {
			.customers-logo__content {
				overflow-x: hidden;
				scroll-snap-type: none;
			}

			// The track's gap is the seam between the set and its copy; the sets' own end
			// padding is for the resting row, where it is the space to the edges.
			.customers-logo__set {
				padding-inline: 0;
			}

			.customers-logo__set[aria-hidden='true'] {
				display: flex;
			}

			.customers-logo__track {
				animation: customers-logo-loop var(--marquee-duration, 24s) linear infinite;
			}
		}

		&[data-held],
		&[data-offscreen],
		&__content:focus-within {
			.customers-logo__track {
				animation-play-state: paused;
			}
		}

		@media (hover: hover) {
			&__content:hover .customers-logo__track {
				animation-play-state: paused;
			}
		}

		@media (prefers-reduced-motion: reduce) {
			&__track {
				animation: none !important;
			}
		}

		// Full-bleed dark band under the homepage hero; the row itself is capped at the
		// page's 960 measure and centred on it, its marks inset by their end gaps.
		&--dark {
			max-width: none;
			background-color: #000;

			// Smaller than the light rows, leaning small: the strip closes the hero rather
			// than opening the page, so the marks support it. Measured: on the 960 measure
			// (from ~1000px) the row settles with 40px between marks and 40 at each end,
			// the widest mark 108 — the fit binds before the 120 ceiling does — and the
			// outer marks 69px from the edge at 1024, where the hero's copy stands at 28.
			// At the floor the narrowest is 56 and the row loops below a ~750px viewport.
			// The strip is ~99 tall on desktop, 70 below it.
			--mark-min-w: 56px;
			--mark-max-w: 120px;

			// Marks stay plain white — `brightness(0) invert(1)` above flattens each
			// one — so the only variable is how far it sits back from the strip.
			// Opacity alone carries that, which keeps every mark the same hue at
			// rest and on hover.
			img {
				opacity: 0.5;
				transition: opacity 0.18s ease;
			}

			.customers-logo__item:hover img,
			.customers-logo__item:focus-visible img {
				opacity: 1;
			}
		}
	}

	@keyframes customers-logo-loop {
		to {
			transform: translateX(calc(-1 * var(--marquee-distance, 0px)));
		}
	}
</style>

<script>
	// The loop is switched on here rather than in CSS because its condition, "the row does
	// not fit its strip", is a comparison CSS cannot make. Without this script the strip is
	// the plain swipeable row.
	const SPEED = 20; // px per second: a mark takes ~19s to cross a phone, one loop ~34s

	for (const strip of document.querySelectorAll<HTMLElement>('[data-logo-strip]')) {
		const viewport = strip.querySelector<HTMLElement>('.customers-logo__content');
		const [set, copy] = strip.querySelectorAll<HTMLElement>('.customers-logo__set');
		if (!viewport || !set || !copy) continue;

		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

		// The set's width at its minimum spacing, not as laid out: while it fits, it is
		// spread across the row. A gap between each pair and one at each end, as the resting
		// row keeps them, so a row that fits never has a mark on the edge.
		const fits = () => {
			const items = [...set.children] as HTMLElement[];
			const gap = parseFloat(getComputedStyle(set).columnGap) || 0;
			const need = items.reduce((sum, item) => sum + item.getBoundingClientRect().width, 0) + gap * (items.length + 1);
			const room = viewport.clientWidth - 2 * parseFloat(getComputedStyle(viewport).paddingLeft);
			return need <= room + 1;
		};

		const update = () => {
			const loop = !reduce.matches && !fits();
			if (loop !== strip.hasAttribute('data-marquee')) viewport.scrollLeft = 0;
			strip.toggleAttribute('data-marquee', loop);
			if (!loop) return;
			// One set plus the gap before the copy: after exactly this the copy stands where
			// the set started, so the restart is invisible. From the boxes, not `offsetLeft`,
			// which rounds to whole pixels and would leave the seam up to one pixel off.
			const distance = copy.getBoundingClientRect().left - set.getBoundingClientRect().left;
			strip.style.setProperty('--marquee-distance', `${distance}px`);
			strip.style.setProperty('--marquee-duration', `${(distance / SPEED).toFixed(2)}s`);
		};

		new ResizeObserver(update).observe(viewport);
		reduce.addEventListener('change', update);

		// A finger on the strip holds it still, so a moving logo can be read or tapped.
		const hold = (held: boolean) => () => strip.toggleAttribute('data-held', held);
		viewport.addEventListener('pointerdown', hold(true));
		for (const type of ['pointerup', 'pointercancel', 'pointerleave']) viewport.addEventListener(type, hold(false));

		new IntersectionObserver(([entry]) => strip.toggleAttribute('data-offscreen', !entry.isIntersecting)).observe(
			strip
		);
	}
</script>
