---
import { Icon } from 'astro-icon/components';
import BaseLayout from '@layouts/BaseLayout.astro';
import SmartImage from '@components/SmartImage.astro';
import { externalLinkAttrs } from '@util/external-links';
import { installProducts } from '@data/installationsHub';

/** Splits a product name around its highlighted word, e.g. "ThingsBoard " + "Cloud". */
const splitName = (name: string, highlight?: string) => {
	const at = highlight ? name.indexOf(highlight) : -1;
	return at === -1 ? [name, '', ''] : [name.slice(0, at), highlight, name.slice(at + highlight!.length)];
};
---

<BaseLayout
	headerVariant="solid-shadow"
	forceLightTheme
	title="Install ThingsBoard"
	description="Get ThingsBoard running: sign up for ThingsBoard Cloud in your region, or install ThingsBoard On-premises, Edge, Trendz and the IoT Gateway from their guides."
>
	<div class="install">
		<header class="install__container install__intro">
			<h1 class="install__intro-title">Get ThingsBoard running</h1>
			<p class="install__intro-text">
				Pick where it runs. Cloud needs nothing installed; everything else has a guide for every way it installs.
			</p>
		</header>

		{
			installProducts.map((p) => {
				const [before, highlight, after] = splitName(p.name, p.nameHighlight);
				const groups = p.aside?.options ?? p.options ?? [];
				return (
					<section
						id={p.id}
						class:list={['install__product', p.badgeFill && 'is-platform', p.regions && 'is-band']}
						style={{ '--accent': p.accent, '--badge-fill': p.badgeFill }}
					>
						<div class="install__container">
							<header class="install__head">
								<span class="install__mark" aria-hidden="true">
									<SmartImage src={p.icon} alt="" class="install__icon" width="96" height="96" loading="lazy" />
								</span>
								<div>
									<p class="install__label">{p.label}</p>
									<h2 class="install__title">
										{before}
										{highlight && <span class="install__title-accent">{highlight}</span>}
										{after}
									</h2>
								</div>
							</header>

							<div class="install__grid">
								<div>
									<p class="install__text">{p.description}</p>

									{p.regions && (
										<div class="install__regions">
											<p class="install__group-title">Try now</p>
											<ul>
												{p.regions.map((region) => {
													const signup = `https://${region.host}/signup`;
													return (
														<li data-region={region.id}>
															<a class="install__region" href={signup} {...externalLinkAttrs(signup)}>
																<span class="install__region-globe">
																	<Icon name="tabler:world" aria-hidden="true" />
																</span>
																<span class="install__region-name">
																	{region.name}
																	<small>{region.note}</small>
																</span>
																<span class="install__region-cta">
																	Sign up
																	<span class="sr-only"> for ThingsBoard Cloud in {region.name}</span>
																	<Icon name="tabler:chevron-right" aria-hidden="true" />
																</span>
															</a>
														</li>
													);
												})}
											</ul>
										</div>
									)}

									<div class="install__actions">
										{p.primary && (
											<a class="install__button" href={p.primary.href}>
												{p.cornerIcon && <Icon name={p.cornerIcon} aria-hidden="true" />}
												{p.primary.label}
												<span class="sr-only"> — {p.name}</span>
											</a>
										)}
										{p.links.map((link) => (
											<a class="install__link" href={link.href}>
												{link.label}
												<span class="sr-only"> — {p.name}</span>
												<Icon name="tabler:chevron-right" aria-hidden="true" />
											</a>
										))}
									</div>
								</div>

								{groups.length > 0 && (
									<div class="install__panel">
										{p.aside && (
											<div class="install__aside">
												<h3 class="install__aside-title">
													<Icon name="tabler:cloud-lock" aria-hidden="true" />
													{p.aside.title}
												</h3>
												<p class="install__text">{p.aside.text}</p>
												<div class="install__actions">
													{p.aside.links.map((link) => (
														<a class="install__link" href={link.href}>
															{link.label}
															<span class="sr-only"> — {p.aside!.title}</span>
															<Icon name="tabler:chevron-right" aria-hidden="true" />
														</a>
													))}
												</div>
											</div>
										)}
										{groups.map((group) => (
											<div class="install__group">
												<p class="install__group-title">{group.title}</p>
												<ul class="install__chips">
													{group.items.map((option) => (
														<li>
															<a class="install__chip" href={option.href}>
																<SmartImage src={option.logo} alt="" width="90" height="18" loading="lazy" />
																<span>
																	{option.label}
																	{option.note && <span class="install__chip-note"> {option.note}</span>}
																</span>
															</a>
														</li>
													))}
												</ul>
											</div>
										))}
									</div>
								)}
							</div>
						</div>
					</section>
				);
			})
		}
	</div>
</BaseLayout>

<style lang="scss">
	@use '../../styles/variables' as *;

	.install {
		padding-bottom: $spacing-20;
		background: var(--color-bg);
	}

	.install__container {
		max-width: 1000px;
		margin-inline: auto;
		padding-inline: $spacing-5;
	}

	.install__intro {
		padding-block: $spacing-12;
		text-align: center;
	}

	.install__intro-title {
		@include section-title;

		margin: 0 0 $spacing-5;
		color: var(--color-text);
	}

	.install__intro-text {
		@include text-m;

		max-width: 65ch;
		margin: 0 auto;
		color: var(--color-text);
	}

	// ── Product section ───────────────────────────────────────────────
	.install__product {
		padding-block: $spacing-10;

		& + & {
			border-top: 1px solid var(--color-border);
		}

		// Cloud runs as a full-width tinted band.
		&.is-band {
			background: linear-gradient(
				150deg,
				color-mix(in srgb, var(--badge-fill) 22%, #fff),
				color-mix(in srgb, var(--badge-fill) 6%, #fff)
			);

			+ .install__product {
				border-top: 0;
			}
		}
	}

	.install__head {
		display: flex;
		align-items: center;
		gap: $spacing-5;
		margin-bottom: $spacing-5;
	}

	.install__mark {
		display: grid;
		flex: none;
		place-items: center;
		width: 72px;
		height: 72px;
		border-radius: 24%;
		background: linear-gradient(155deg, #fff 40%, color-mix(in srgb, var(--accent) 8%, #fff));
		box-shadow: 0 6px 18px rgba(0, 0, 0, 0.08);

		@include media-down(sm) {
			width: 56px;
			height: 56px;
		}
	}

	.install__icon {
		width: 82%;
		height: auto;
	}

	.is-platform {
		.install__mark {
			background: var(--badge-fill) linear-gradient(150deg, rgba(255, 255, 255, 0.24), transparent 62%);
		}

		.install__icon {
			width: 92%;
			filter: brightness(0) invert(1);
		}
	}

	.install__label {
		@include text-xs;

		letter-spacing: 0.06em;
		text-transform: uppercase;

		margin: 0 0 $spacing-1;
		color: var(--color-text-secondary);
	}

	.install__title {
		@include card-title;

		margin: 0;
		color: var(--color-text);
	}

	.install__title-accent {
		color: var(--badge-fill, inherit);
	}

	.install__grid {
		display: grid;
		grid-template-columns: minmax(0, 13fr) minmax(0, 10fr);
		gap: $spacing-8 $spacing-10;
		align-items: start;

		@include media-down(md) {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	.install__text {
		@include text-m;

		max-width: 46ch;
		margin: 0;
		color: var(--color-text);
	}

	// ── Actions ───────────────────────────────────────────────────────
	.install__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: $spacing-3 $spacing-4;
		margin-top: $spacing-6;
	}

	.install__button {
		@include button-base;

		gap: $spacing-2;
		height: 44px;
		padding: 0 $spacing-4;
		border: 1px solid var(--color-border-light);
		border-radius: $radius-md;
		background: transparent;
		color: var(--color-text);

		:global(svg) {
			width: 20px;
			height: 20px;
		}

		&:hover {
			background-color: var(--color-bg-light);
		}

		&:focus-visible {
			outline: 2px solid currentColor;
			outline-offset: 3px;
		}

		.is-platform & {
			border-color: var(--badge-fill);
			background-color: var(--badge-fill);
			color: #fff;

			&:hover {
				background-image: linear-gradient(rgba(0, 0, 0, 0.2), rgba(0, 0, 0, 0.2));
			}

			&:focus-visible {
				outline-color: var(--badge-fill);
			}
		}
	}

	.install__link {
		@include text-m;

		font-weight: $font-weight-medium;

		display: inline-flex;
		align-items: center;
		gap: $spacing-1;
		color: var(--color-brand);
		text-decoration: none;

		:global(svg) {
			width: 1.1em;
			height: 1.1em;
		}

		&:hover {
			text-decoration: underline;
		}
	}

	// ── Cloud regions ─────────────────────────────────────────────────
	.install__regions {
		max-width: 480px;
		margin-top: $spacing-6;

		.install__group-title {
			color: var(--badge-fill);
		}

		ul {
			display: grid;
			gap: $spacing-3;
			margin: 0;
			padding: 0;
			list-style: none;
		}

		[data-region='us'] {
			--region-hue: #{$color-brand};
		}

		[data-region='eu'] {
			--region-hue: #0f9b8e;
		}
	}

	.install__region {
		display: flex;
		align-items: center;
		gap: $spacing-3;
		padding: $spacing-3 $spacing-4;
		border-radius: $radius-lg;
		background: var(--color-bg-surface);
		box-shadow:
			0 1px 2px rgba(23, 24, 28, 0.06),
			0 6px 18px rgba(23, 24, 28, 0.06);
		color: var(--color-text);
		text-decoration: none;

		&:hover {
			box-shadow:
				0 1px 2px rgba(23, 24, 28, 0.08),
				0 10px 24px rgba(23, 24, 28, 0.1);
		}

		&:focus-visible {
			outline: 2px solid var(--badge-fill);
			outline-offset: 3px;
		}
	}

	.install__region-globe {
		display: grid;
		flex: none;
		place-items: center;
		width: 36px;
		height: 36px;
		border-radius: 50%;
		background: color-mix(in srgb, var(--region-hue) 14%, #fff);
		color: var(--region-hue);

		:global(svg) {
			width: 20px;
			height: 20px;
		}
	}

	.install__region-name {
		display: flex;
		flex: 1;
		flex-direction: column;
		min-width: 0;
		font-weight: $font-weight-bold;
		line-height: 1.3;

		small {
			@include text-s;

			font-weight: $font-weight-normal;
			color: var(--color-text-secondary);
		}
	}

	.install__region-cta {
		@include text-s;

		font-weight: $font-weight-medium;

		display: inline-flex;
		flex: none;
		align-items: center;
		gap: $spacing-1;
		color: var(--badge-fill);

		:global(svg) {
			width: 18px;
			height: 18px;
		}
	}

	// ── Side panel: Private Cloud and install options ─────────────────
	.install__panel {
		display: grid;
		gap: $spacing-5;
		padding: $spacing-5;
		border: 1px solid var(--color-border);
		border-radius: $radius-lg;
		background: var(--color-bg-surface);

		@include media-down(sm) {
			padding: $spacing-4;
		}
	}

	.install__aside .install__actions {
		margin-top: $spacing-3;
	}

	.install__aside-title {
		@include text-m;

		font-weight: $font-weight-semibold;

		display: flex;
		align-items: center;
		gap: $spacing-3;
		margin: 0 0 $spacing-3;
		color: var(--color-text);

		:global(svg) {
			flex: none;
			width: 24px;
			height: 24px;
			color: var(--badge-fill);
		}
	}

	.install__group-title {
		@include text-xs;

		letter-spacing: 0.06em;
		text-transform: uppercase;

		margin: 0 0 $spacing-3;
		color: var(--color-text-secondary);
	}

	.install__chips {
		display: flex;
		flex-wrap: wrap;
		gap: $spacing-2;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.install__chip {
		@include text-m;

		display: inline-flex;
		align-items: center;
		gap: $spacing-2;
		min-height: 40px;
		padding: $spacing-1 $spacing-4;
		border: 1px solid var(--color-border-light);
		border-radius: $radius-full;
		background: var(--color-bg-surface);
		color: var(--color-text);
		font-weight: $font-weight-medium;
		text-decoration: none;

		:global(img) {
			flex: none;
			width: auto;
			height: 20px;
		}

		&:hover {
			border-color: var(--color-text-secondary);
			background: var(--color-bg-light);
		}
	}

	.install__chip-note {
		color: var(--color-text-secondary);
		font-weight: $font-weight-normal;
	}
</style>
