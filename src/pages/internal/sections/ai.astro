---
import VisualPage from '@root/pages/internal/_VisualPage.astro';
import Variant from '@root/pages/internal/_Variant.astro';
import AiSection from '@components/Landing/AiSection.astro';
import AiTwoUp from '@components/Landing/AiTwoUp.astro';
import AiWide from '@components/Landing/AiWide.astro';
import { kv } from '@root/pages/internal/_key-visuals';

/**
 * The AI section — "Build IoT solutions faster than ever with AI inside ThingsBoard".
 *
 * A SECTION rather than a row: it carries its own header and two full-bleed bands, so every direction
 * here is a `bleed` Variant. The desktop view is the section edge to edge at this window's width, as
 * `index.astro` places it; the phone view frames it at 375, so its viewport queries fire against a
 * real phone viewport rather than a narrow box.
 *
 * ORDER: the SHIPPING `AiSection` first, then candidates newest first, then the previous homepage last.
 * ADD a candidate under the shipping one, as a component beside `AiSection`, never as an edit to it.
 * A candidate that differs by one setting can instead be a prop on `AiSection` whose default is
 * today's behaviour, passed here through `props` — and it then FOLLOWS the shipping section, taking
 * whatever is promoted into it later.
 *
 * A REFERENCE (a previous homepage) must pin EVERY prop it depends on, not just the one it differs
 * by, or the next promotion changes it too: `bands` pins `terminal: 'cli'`, because the 2026-09-24
 * promotion made the agent terminal the default and it silently took it.
 *
 * CANDIDATE 2026-09-26: `AiWide`, a component beside `AiSection` — the switcher with a 600px window
 * beside smaller copy that ends on a call to action; both windows whole and squarer, the chat's bar a
 * plain label, the terminal at 14px printing the ThingsBoard wordmark, then its status, then the
 * session. `wash: 'cycle'` is the same section with the band following the mark's colours.
 *
 * CANDIDATE 2026-09-26: `AiTwoUp`, a component beside `AiSection` — both routes side by side under one
 * band, each window over its copy, the band washed from its corners in the two routes' hues.
 *
 * PROMOTED 2026-09-23: the toggle with the hand-off, now `AiSection`'s default and the homepage's.
 * The plain-fade toggle was retired and deleted with it. `layout="bands"` is the page that came
 * before, kept as the reference.
 *
 * PROMOTED 2026-09-24, later: the freezer-door chat and windows that fill their column, judged here
 * together as one direction and folded into `AiSection` as `chat` and `fit` defaults. The page before
 * them is `fit="inset"` + `chat="dewPoint"`, kept beside the reference; `bands` pins both as well.
 *
 * PROMOTED 2026-09-24: the coding-agent terminal, judged here as `AiSectionNext` (a full copy, so its
 * content could change the sizing) and folded back into `AiSection` as the default. The shell
 * terminal it replaced is `terminal="cli"`; its own variant was retired, as it matched the shipping
 * section until the second tab was picked, and `bands` still shows it.
 */
---

<VisualPage visual="ai">
	<Variant
		visual={kv('ai')}
		component={AiSection}
		bleed
		shipping
		name="Toggle"
		note="The toggle with the hand-off (2026-09-23), the coding-agent terminal, the freezer-door chat and windows that fill their column (2026-09-24), all promoted from this page"
	/>

	<Variant
		visual={kv('ai')}
		component={AiWide}
		bleed
		name="Wide window"
		note="candidate · the switcher with the window at 600 of the 960 measure; both windows whole and squarer, the chat's bar a plain label, the terminal at 14px opening on the ThingsBoard wordmark, its status under it, then the session; smaller headings, no kickers, and a call to action under each route's copy"
	/>

	<Variant
		visual={kv('ai')}
		component={AiWide}
		props={{ wash: 'cycle' }}
		bleed
		name="Wide window · cycling wash"
		note="candidate · the Wide window with the band's wash following the section's mark through the other sections' hues, on the mark's clock, instead of the showing route's hue"
	/>

	<Variant
		visual={kv('ai')}
		component={AiTwoUp}
		bleed
		name="Two-up"
		note="candidate · both routes side by side under one band, each window over its copy; the wash rises from the band's corners, green on the chat's side and violet on the terminal's"
	/>

	<Variant
		visual={kv('ai')}
		component={AiSection}
		props={{ wash: 'cycle' }}
		bleed
		name="Wash follows mark"
		note="experimental · the band's wash cycles with the mark's colours, in step; the kicker-less copy, so no coloured type rides a moving ground"
	/>

	<Variant
		visual={kv('ai')}
		component={AiSection}
		props={{ copy: 'value' }}
		bleed
		name="Value copy"
		note="candidate · a kicker naming the tool, and headlines that say what you get"
	/>

	<Variant
		visual={kv('ai')}
		component={AiSection}
		props={{ fit: 'inset', chat: 'dewPoint' }}
		bleed
		name="Inset windows"
		note="previous homepage (2026-09-24, before the chat and the fit were promoted) · both windows 500 wide and centred in their column; the dew-point chat"
	/>

	<Variant
		visual={kv('ai')}
		component={AiSection}
		props={{ layout: 'bands', terminal: 'cli', chat: 'dewPoint', fit: 'inset' }}
		bleed
		name="Bands"
		note="previous homepage · both routes stacked, with the lede, the kickers and the shell terminal"
	/>
</VisualPage>

{
	/* THE HOMEPAGE'S CONTEXT, which the section is drawn against and the playground does not load.
	   Here rather than in `_Variant`, because every sandbox page imports that and none of the others
	   want any of it.

	   Found by diffing the computed style of every element in the section, `/` against this page, at
	   the same width — and the diff is the test if a variant ever looks different here: before this
	   block the chat's app bar, chip and composer line all came out shorter (line-height `normal`
	   against 24px) and the title sat 27px lower (the UA's h2 margin). */
}
<style lang="scss" is:global>
	@use '../../../styles/variables' as *;

	// The `section .main-div` container, its ~5px margin that `.ai__band` zeroes, and the 1000px
	// measure. `landing` also gives every `section` the page ground, which `index.astro` strips again
	// — the bands carry their own gradient, and a fill under them is a colour the homepage never paints.
	@use '../../../styles/landing';
	@use '../../../styles/sections-flat';

	:root section {
		background: none;
	}

	// The rest reaches the SECTION ONLY, through its wrapper, and every selector is `:where()`-wrapped
	// so it lands at the specificity the homepage's own rule has. One class heavier and these would
	// start beating the section's scoped rules, which is the opposite of fidelity.

	// What the homepage body passes down: `BaseLayout`'s two Starlight properties, and Starlight's
	// body rule reading them. The playground's body sets its own colour and no line-height.
	.vx__bleed {
		--sl-line-height: 1.5;
		--__sl-font: #{$font-family-base};
		line-height: var(--sl-line-height);
		color: var(--sl-color-text);
	}

	// Starlight's reset, in Starlight's layer — so, as on the homepage, anything the section writes
	// beats it.
	@layer starlight.reset {
		:where(.vx__bleed) * {
			margin: 0;
		}

		:where(.vx__bleed) :is(input, button, textarea, select) {
			font: inherit;
		}

		:where(.vx__bleed) :is(p, h1, h2, h3, h4, h5, h6, code) {
			overflow-wrap: break-word;
		}
	}

	// `index.astro`'s page-wide wrapping.
	:where(.vx__bleed) :is(h1, h2, h3) {
		text-wrap: balance;
	}

	:where(.vx__bleed) p {
		text-wrap: pretty;
	}

	// The playground caps every `svg` at its box; the homepage does not.
	:where(.vx__bleed) svg {
		max-width: none;
	}
</style>
