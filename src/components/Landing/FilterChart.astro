---
import AlarmEntry from '@components/Landing/AlarmEntry.astro';
import { ALARM_FIRED_AT, FILTER_CHART, FILTER_HISTORY, FREEZER_ALARM, openFor } from '@data/automate-visual';
import { filterChartFrames } from '@util/filter-chart-frames';

/**
 * Filter without the mark — the homepage's since 2026-09-27, over `FilterFlow` — as a chart with as little ink as it can carry.
 *
 * THE MORNING'S OPENINGS AS BARS, each at the time it happened (07:30 to 10:00) and as tall as the
 * door stood open, against one dashed limit. Most are short, which is the point: the rule leaves them
 * alone. The one still open climbs past the limit, turns red, and the alarm (`AlarmEntry`) opens where
 * it crossed. No grid, no value axis: the limit is labelled where a value axis would sit, the time axis at its two
 * ends, and the live bar carries its own reading. Everything else on the page is data. Each opening
 * stands in a faint column up to the limit — how much of its allowance it used — with its length over
 * it, and the limit is a handle: drag it and the rule re-applies (see the second script).
 *
 * On the other tabs' frame, 574 × 256 units, so the switch's row holds its height. One SVG in the
 * frame's own units; the alarm is HTML over it in the same units. Type floor 15 units, R = 38.
 *
 * MOTION, 8s while the tab shows (`--flow-play`): the morning's bars stand still — a chart only
 * grows forwards — and the live one climbs at one pace, crosses the limit (3:00 by default),
 * turns red, and the alarm rises in where it crossed. It holds, then the live bar and what it raised
 * let go quickly, and it climbs again. Without motion: the picture at rest, alarm up.
 */

// --- the frame --------------------------------------------------------------------------------
const NATIVE = 574;
const H = 256;
const PLOT = { x0: 56, x1: 558, top: 64, base: 214 };
const ALARM_W = 236;
const BAR_W = 10;
const Y_MAX = 4.5 * 60;
/** The window, in minutes after midnight: 07:30 to 10:00, the live opening a little left of middle. */
const DAY = { from: 7 * 60 + 30, to: 10 * 60 };

const r2 = (v: number) => +v.toFixed(2);
const xOfMin = (minAfter6: number) =>
	r2(PLOT.x0 + ((minAfter6 + 6 * 60 - DAY.from) / (DAY.to - DAY.from)) * (PLOT.x1 - PLOT.x0));
const yOf = (s: number) => r2(PLOT.base - (s / Y_MAX) * (PLOT.base - PLOT.top));
const hhmm = (min: number) => `${String(Math.floor(min / 60)).padStart(2, '0')}:${String(min % 60).padStart(2, '0')}`;

// --- the bars ---------------------------------------------------------------------------------
const bars = FILTER_HISTORY.map((o) => ({
	cx: xOfMin(o.at),
	x: r2(xOfMin(o.at) - BAR_W / 2),
	y: yOf(o.open),
	open: o.open,
	start: 6 * 3600 + o.at * 60,
}));
const liveMin = FILTER_CHART.openedAt / 60 - 6 * 60;
const liveX = xOfMin(liveMin);
const limitY = yOf(FILTER_CHART.limit);
/** The limit's range when dragged: long enough to catch any past opening, short of the chart's top. */
const LIMIT = { min: 30, max: Y_MAX - 15, step: 5 };

// --- the live bar's climb ---------------------------------------------------------------------
// One pace: 6s to the top of its range (the drag's own top), stopping a few seconds past the limit
// once the rule has fired (`filterChartFrames`, shared with the drag's replay).
const PEAK = LIMIT.max;
const uid = `fch-${Math.random().toString(36).slice(2, 8)}`;
const frames = filterChartFrames(uid, FILTER_CHART.limit, PEAK, { base: PLOT.base, top: PLOT.top, yMax: Y_MAX });
const liveTop = yOf(PEAK);

// --- the alarm --------------------------------------------------------------------------------
const alarmX = r2(liveX + 22);
if (alarmX + ALARM_W > PLOT.x1) {
	throw new Error(`FilterChart: the alarm (${alarmX}–${alarmX + ALARM_W}) runs past the plot's edge at ${PLOT.x1}`);
}

// What the drag needs to redraw the rule: the plot, each opening's position, length and start.
const geo = {
	peak: PEAK,
	top: PLOT.top,
	base: PLOT.base,
	yMax: Y_MAX,
	x1: PLOT.x1,
	h: H,
	alarmW: ALARM_W,
	limit: LIMIT,
	bars: [
		...bars.map((b) => ({ x: b.cx, open: b.open, start: b.start })),
		{ x: liveX, open: PEAK, start: FILTER_CHART.openedAt },
	],
};

const chartLabel = `${FILTER_CHART.title}, ${hhmm(DAY.from)} to ${hhmm(DAY.to)}: ${FILTER_HISTORY.length} short openings, then one left open past the ${openFor(FILTER_CHART.limit)} limit, which raised a ${FREEZER_ALARM.severity.toLowerCase()} alarm, ${FREEZER_ALARM.name}, at ${ALARM_FIRED_AT}.`;
---

<style is:inline set:html={frames.css} data-fch-style={uid}></style>

<div class="fch-fit">
	<div
		class="fch"
		data-fch={uid}
		data-fch-loop={frames.loop}
		data-fch-climb={JSON.stringify(frames.climb)}
		data-fch-end={frames.end}
		data-fch-geo={JSON.stringify(geo)}
		data-fch-title={FILTER_CHART.title}
		data-flow="in"
		style={[
			`--fch-u: min(1.15px, calc(100cqw / ${NATIVE}))`,
			`--fch-native: ${NATIVE}`,
			`--fch-h: ${H}`,
			`--fch-alarm-x: ${alarmX}`,
			`--fch-alarm-w: ${ALARM_W}`,
			`--fch-limit-y: ${limitY}`,
			`--fch-loop: ${frames.loop}s`,
		].join('; ')}
	>
		<svg class="fch__chart" viewBox={`0 0 ${NATIVE} ${H}`} role="img" aria-label={chartLabel}>
			<text class="fch__title" x="0" y="34">{FILTER_CHART.title}</text>

			{
				[...bars.map((b) => b.x), r2(liveX - BAR_W / 2)].map((x) => (
					<rect class="fch__track" x={x} y={limitY} width={BAR_W} height={r2(PLOT.base - limitY)} rx="1" />
				))
			}

			<line class="fch__limit" x1={PLOT.x0} y1={limitY} x2={PLOT.x1} y2={limitY}></line>

			<line class="fch__base" x1={PLOT.x0} y1={PLOT.base} x2={PLOT.x1} y2={PLOT.base}></line>
			<text class="fch__tick is-start" x={PLOT.x0} y={H - 14}>{hhmm(DAY.from)}</text>
			<text class="fch__tick is-end" x={PLOT.x1} y={H - 14}>{hhmm(DAY.to)}</text>

			{
				bars.map((b) => (
					<>
						<rect class="fch__bar" x={b.x} y={b.y} width={BAR_W} height={r2(PLOT.base - b.y)} rx="1" />
						<text class="fch__bar-label" x={b.cx} y={b.y - 7}>
							{b.open}s
						</text>
					</>
				))
			}

			<rect
				class="fch__live"
				x={r2(liveX - BAR_W / 2)}
				y={liveTop}
				width={BAR_W}
				height={r2(PLOT.base - liveTop)}
				rx="1"></rect>

			<line class="fch__link fch__fade" x1={liveX} y1={limitY} x2={alarmX} y2={limitY}></line>
			<circle class="fch__fired fch__fade" cx={liveX} cy={limitY} r="5"></circle>

			<g class="fch__reading">
				<text class="fch__readout" x={liveX} y={liveTop - 10} data-fch-readout>{openFor(frames.end)}</text>
			</g>
		</svg>

		{/* The rule's limit, as a handle: drag it (or use the arrow keys) and the chart re-applies it. */}
		<button
			type="button"
			class="fch__handle"
			role="slider"
			aria-orientation="vertical"
			aria-label="Alarm when the door stays open longer than"
			aria-valuemin={LIMIT.min}
			aria-valuemax={LIMIT.max}
			aria-valuenow={FILTER_CHART.limit}
			aria-valuetext={openFor(FILTER_CHART.limit)}
			data-fch-handle
		>
			<span class="fch__grip" aria-hidden="true"></span>
			<span data-fch-limit-text>{openFor(FILTER_CHART.limit)}</span>
		</button>

		<div class="fch__alarm-at fch__fade" aria-hidden="true">
			<div class="fch__alarm-move">
				<AlarmEntry />
			</div>
		</div>
	</div>
</div>

<script>
	// The live reading: the door's open time, read off the live bar's own CSS clock with the same
	// schedule its keyframes follow, so the number and the bar cannot drift apart, and it stops when
	// the switch pauses the tab. Only while on screen.
	const fmt = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;

	document.querySelectorAll<HTMLElement>('[data-fch]').forEach((root) => {
		const readout = root.querySelector<SVGTextElement>('[data-fch-readout]');
		const bar = root.querySelector<SVGRectElement>('.fch__live');
		if (!readout || !bar) return;
		let frame = 0;
		let last = '';

		// A dragged limit rewrites the loop, its length and where the climb stops: re-read when it does.
		let key = '';
		let end = 0;
		let loop = 0;
		let climb: [number, number][] = [];
		const read = () => {
			const next = (root.dataset.fchClimb ?? '') + root.dataset.fchLoop;
			if (next === key) return;
			key = next;
			end = Number(root.dataset.fchEnd);
			loop = Number(root.dataset.fchLoop) * 1000;
			climb = JSON.parse(root.dataset.fchClimb ?? '[]') as [number, number][];
		};
		const panel = root.closest<HTMLElement>('.auto__panel');

		const valueAt = (pct: number) => {
			if (pct <= climb[0][0]) return 0;
			for (let k = 1; k < climb.length; k++) {
				const [p0, s0] = climb[k - 1];
				const [p1, s1] = climb[k];
				if (pct <= p1) return s0 + ((pct - p0) / (p1 - p0)) * (s1 - s0);
			}
			return end;
		};

		const tick = () => {
			// Held by a drag, or on a tab not showing: nothing to read this frame.
			if (root.classList.contains('is-manual') || (panel && !panel.classList.contains('is-active'))) {
				frame = requestAnimationFrame(tick);
				return;
			}
			read();
			const anim = bar.getAnimations()[0];
			const pct = anim ? ((Number(anim.currentTime ?? 0) % loop) / loop) * 100 : 100;
			// Nothing to read before the bar has started: no "0:00" on an empty foot.
			const value = valueAt(pct);
			const text = value < 5 ? '' : fmt(value);
			if (text !== last) readout.textContent = last = text;
			frame = requestAnimationFrame(tick);
		};

		new IntersectionObserver(([entry]) => {
			cancelAnimationFrame(frame);
			if (entry.isIntersecting) frame = requestAnimationFrame(tick);
		}).observe(root);
	});
</script>

<script>
	// THE LIMIT IS MOVABLE. Dragging the handle (or the arrow keys on it) holds the picture and
	// re-applies the rule at the new limit — every opening over it turns red, each column's empty part
	// shrinks or grows to it — with the alarm on the latest opening over it, its time the moment that
	// opening crossed. Let go and the new limit is tested: the loop plays again against it.
	import { filterChartFrames } from '@util/filter-chart-frames';

	interface Geo {
		peak: number;
		top: number;
		base: number;
		yMax: number;
		x1: number;
		h: number;
		alarmW: number;
		limit: { min: number; max: number; step: number };
		bars: { x: number; open: number; start: number }[];
	}

	const openFor = (s: number) => `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
	const clock = (s: number) =>
		[Math.floor(s / 3600), Math.floor((s % 3600) / 60), s % 60].map((n) => String(n).padStart(2, '0')).join(':');

	document.querySelectorAll<HTMLElement>('[data-fch]').forEach((root) => {
		const handle = root.querySelector<HTMLButtonElement>('[data-fch-handle]');
		const svg = root.querySelector<SVGSVGElement>('.fch__chart');
		if (!handle || !svg) return;
		const geo = JSON.parse(root.dataset.fchGeo ?? '{}') as Geo;
		const limitLine = root.querySelector<SVGLineElement>('.fch__limit');
		const tracks = [...root.querySelectorAll<SVGRectElement>('.fch__track')];
		const bars = [...root.querySelectorAll<SVGRectElement>('.fch__bar, .fch__live')];
		const link = root.querySelector<SVGLineElement>('.fch__link');
		const dot = root.querySelector<SVGCircleElement>('.fch__fired');
		const text = handle.querySelector<HTMLElement>('[data-fch-limit-text]');
		const time = root.querySelector<HTMLElement>('.alarm-entry__time');
		const yOf = (s: number) => geo.base - (s / geo.yMax) * (geo.base - geo.top);
		let limit = Number(handle.getAttribute('aria-valuenow'));
		const uid = root.dataset.fch ?? '';
		const styleEl = document.querySelector<HTMLStyleElement>(`style[data-fch-style="${uid}"]`);
		const liveBar = root.querySelector<SVGRectElement>('.fch__live');
		const reading = root.querySelector<SVGGElement>('.fch__reading');
		const readout = root.querySelector<SVGTextElement>('[data-fch-readout]');
		let testing = 0;

		// TEST: replay the loop against the new limit. The climb is the same; only the moment it crosses
		// moves, so the keyframes that answer the crossing are rewritten from it — or, with the limit
		// above where the live bar stops, written to never fire — and every animation starts over.
		const test = () => {
			if (!styleEl) return;
			const f = filterChartFrames(uid, limit, geo.peak, geo);
			styleEl.textContent = f.css;
			root.dataset.fchLoop = String(f.loop);
			root.dataset.fchClimb = JSON.stringify(f.climb);
			root.dataset.fchEnd = String(f.end);
			root.style.setProperty('--fch-loop', f.loop + 's');
			liveBar?.style.removeProperty('transform');
			reading?.style.removeProperty('transform');
			root.classList.remove('is-manual');
			requestAnimationFrame(() =>
				root.getAnimations({ subtree: true }).forEach((a) => {
					if (a instanceof CSSAnimation) a.currentTime = 0;
				})
			);
		};
		const testSoon = (ms: number) => {
			clearTimeout(testing);
			testing = window.setTimeout(test, ms);
		};

		const title = root.dataset.fchTitle ?? '';
		const apply = (seconds: number) => {
			const { min, max, step } = geo.limit;
			limit = Math.min(max, Math.max(min, Math.round(seconds / step) * step));
			const y = yOf(limit);
			const overCount = geo.bars.filter((b) => b.open > limit).length;
			svg.setAttribute(
				'aria-label',
				title +
					': the limit at ' +
					openFor(limit) +
					', ' +
					(overCount
						? overCount + (overCount > 1 ? ' openings' : ' opening') + ' over it, the latest raising the alarm.'
						: 'no opening over it, so no alarm.')
			);
			root.classList.add('is-manual');
			root.style.setProperty('--fch-limit-y', String(y));
			limitLine?.setAttribute('y1', String(y));
			limitLine?.setAttribute('y2', String(y));
			tracks.forEach((t) => {
				t.setAttribute('y', String(y));
				t.setAttribute('height', String(Math.max(0, geo.base - y)));
			});
			// While held, the live bar stands where the replay will stop it.
			const stop = limit < geo.peak ? Math.min(geo.peak, limit + 6) : geo.peak;
			liveBar?.style.setProperty('transform', 'scaleY(' + stop / geo.peak + ')');
			reading?.style.setProperty('transform', 'translateY(' + (yOf(stop) - yOf(geo.peak)) + 'px)');
			if (readout) readout.textContent = openFor(stop);
			const over = geo.bars.map((b) => b.open > limit);
			bars.forEach((el, i) => el.classList.toggle('is-over', over[i]));
			handle.setAttribute('aria-valuenow', String(limit));
			handle.setAttribute('aria-valuetext', openFor(limit));
			if (text) text.textContent = openFor(limit);

			// The alarm: the latest opening over the limit, to its right if it fits, else to its left.
			const last = geo.bars
				.map((b, i) => (over[i] ? b : null))
				.filter((b) => b !== null)
				.pop();
			root.classList.toggle('no-alarm', !last);
			if (!last) return;
			const right = last.x + 22 + geo.alarmW <= geo.x1;
			const ax = right ? last.x + 22 : last.x - 22 - geo.alarmW;
			root.style.setProperty('--fch-alarm-x', String(ax));
			root.style.setProperty('--fch-alarm-y', String(Math.min(geo.h - 66, Math.max(66, y))));
			link?.setAttribute('x1', String(last.x));
			link?.setAttribute('x2', String(right ? ax : ax + geo.alarmW));
			link?.setAttribute('y1', String(y));
			link?.setAttribute('y2', String(y));
			dot?.setAttribute('cx', String(last.x));
			dot?.setAttribute('cy', String(y));
			if (time) time.textContent = clock(last.start + limit);
			// Tell the switch's other drawings: Notify prints the same alarm, so it follows the limit.
			root
				.closest('[data-automate]')
				?.dispatchEvent(
					new CustomEvent('automate:limit', { detail: { limit: openFor(limit), firedAt: clock(last.start + limit) } })
				);
		};

		// Where the pointer is, in the frame's units; the drag keeps the offset it grabbed at, so a tap
		// anywhere on the handle leaves the limit where it was.
		const pointerY = (e: PointerEvent) => {
			const box = svg.getBoundingClientRect();
			return ((e.clientY - box.top) / box.height) * geo.h;
		};
		let grab = 0;
		let moved = false;

		handle.addEventListener('pointerdown', (e) => {
			clearTimeout(testing);
			handle.setPointerCapture(e.pointerId);
			grab = pointerY(e) - yOf(limit);
			moved = false;
		});
		handle.addEventListener('pointermove', (e) => {
			if (!handle.hasPointerCapture(e.pointerId)) return;
			const y = pointerY(e) - grab;
			if (!moved && Math.abs(y - yOf(limit)) < 1) return;
			moved = true;
			apply(((geo.base - y) / (geo.base - geo.top)) * geo.yMax);
		});
		// Let go (or have the touch cancelled), and a moved limit is tested: the loop plays against it.
		const release = () => {
			if (moved) testSoon(150);
			moved = false;
		};
		handle.addEventListener('pointerup', release);
		handle.addEventListener('pointercancel', release);
		handle.addEventListener('lostpointercapture', release);
		handle.addEventListener('keydown', (e) => {
			const { min, max, step } = geo.limit;
			const by: Record<string, number> = {
				ArrowUp: step,
				ArrowRight: step,
				ArrowDown: -step,
				ArrowLeft: -step,
				PageUp: step * 6,
				PageDown: -step * 6,
			};
			if (e.key in by) apply(limit + by[e.key]);
			else if (e.key === 'Home') apply(min);
			else if (e.key === 'End') apply(max);
			else return;
			e.preventDefault();
			testSoon(600);
		});
	});
</script>

<style lang="scss">
	@use '../../styles/variables' as *;

	@function u($n) {
		@return calc(#{$n} * var(--u));
	}

	.fch-fit {
		container-type: inline-size;
	}

	// The chart sits on the row's own ground, no card of its own: the alarm is the one card, over it.
	.fch {
		--u: var(--fch-u);
		--fch-grey: var(--color-text-secondary, #5b616e);
		--fch-hue: var(--flow-rail, var(--color-primary, #3d50f5));
		--fch-alarm: var(--color-accent-red, #b23c33);

		position: relative;
		width: 100%;
		max-width: u(var(--fch-native));
		height: u(var(--fch-h));
		margin: 0 auto;
	}

	.fch__chart {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		max-width: none;
		height: 100%;
		overflow: visible;
	}

	// Set as the alarm's name is, at its size and weight, and subdued: the chart's heading, not its news.
	.fch__title {
		font-size: 17px;
		font-weight: $font-weight-medium;
		fill: var(--fch-grey);
	}

	// In the frame's own units, so 15 here is the family's 15.
	.fch__tick {
		font-family: $font-family-mono;
		font-size: 15px;
		fill: var(--fch-grey);

		&.is-start {
			text-anchor: start;
		}

		&.is-end {
			text-anchor: end;
		}
	}

	.fch__base {
		stroke: var(--color-text, #17181c);
		stroke-opacity: 0.18;
		stroke-width: 1;
		vector-effect: non-scaling-stroke;
	}

	.fch__limit {
		stroke: var(--fch-grey);
		stroke-opacity: 0.55;
		stroke-width: 1;
		stroke-dasharray: 5 4;
		vector-effect: non-scaling-stroke;
	}

	// The past openings: the line's hue, quiet, and still — the chart only ever grows forwards.
	.fch__bar {
		fill: var(--fch-hue);
		opacity: 0.45;
	}

	// The one still open: full strength, red once it passes the limit. At rest it has, so red.
	.fch__live {
		fill: var(--fch-alarm);
		transform-box: fill-box;
		transform-origin: bottom center;
	}

	.fch__link {
		fill: none;
		stroke: var(--fch-alarm);
		stroke-width: max(1px, #{u(2)});
		stroke-linecap: round;
		vector-effect: non-scaling-stroke;
		transform-box: fill-box;
		transform-origin: left center;
	}

	.fch__fired {
		fill: var(--fch-alarm);
		stroke: var(--color-bg-surface, #fff);
		stroke-width: 2;
		transform-box: fill-box;
		transform-origin: center;
	}

	// The live bar's reading, on its top: the only number in the plot.
	.fch__readout {
		font-family: $font-family-mono;
		font-size: 15px;
		font-weight: $font-weight-bold;
		font-variant-numeric: tabular-nums;
		text-anchor: middle;
		fill: var(--fch-alarm);
	}

	// Placed in the frame's units, its left edge where the lit limit ends, centred on the limit (or,
	// with the limit dragged near an edge, held inside the frame).
	.fch__alarm-at {
		position: absolute;
		top: u(var(--fch-alarm-y, var(--fch-limit-y)));
		left: u(var(--fch-alarm-x));
		width: u(var(--fch-alarm-w));
		transform: translateY(-50%);
	}

	// Each opening's column: the empty part is the time left before the rule, up to the limit, so the
	// short openings read as bars (filled a little of the way) rather than as marks on the floor.
	.fch__track {
		fill: var(--fch-hue);
		opacity: 0.08;
	}

	// Every past opening's length over it, in seconds: the column says how far, the label how long.
	.fch__bar-label {
		font-family: $font-family-mono;
		font-size: 15px;
		text-anchor: middle;
		fill: var(--fch-grey);
	}

	// The limit's handle: a white pill with a grip at the value axis, where the limit is labelled.
	.fch__handle {
		position: absolute;
		top: u(var(--fch-limit-y));
		left: 0;
		display: flex;
		align-items: center;
