---
import { Icon } from 'astro-icon/components';
import CloudRegionDialog from '@components/Landing/CloudRegionDialog.astro';
import type { CloudRegionId } from '@util/cloud-regions';

/**
 * The website's region chooser on the ground it ships on. The dialog itself is the shipped
 * `CloudRegionDialog`, rendered here as the site renders it, so the sandbox judges the thing in use
 * rather than a copy of it; what this file adds is the slice of homepage under the trigger.
 *
 * THE BAND under the trigger is a slice of the homepage's top: for sign-up the hero's black column
 * with its CTA row, for sign-in the header bar above it, so each button is judged on the ground it
 * ships on and the phone frame reads as the top of a phone screen. Type is restated here rather than
 * imported: `Hero.astro` and `HeaderContent.astro` scope their rules to their own markup.
 *
 * The root is a `data-cloud-auth-scope`, so a trigger here reaches only the dialog here: two of
 * these can share a page (the sandbox stacks directions), and each is wired to its own.
 *
 * A region leads to the faked product page under the flow's address (`_CloudPage`) rather than
 * to Cloud, so the flow can be clicked through here: button, dialog, form.
 */
interface Props {
	/** Which button opens it: the hero's "Try for free" or the header's "Sign in". */
	flow?: 'signup' | 'signin';
	/** Prefix for the ids the dialog's labelling needs. Distinct per instance on a page. */
	id?: string;
	/** The region marked nearest, pinned so the draft is judged in a known state. */
	nearest?: CloudRegionId;
	/**
	 * Draft only, sign-in: the region marked "Last visited" while this browser has none stored.
	 * The product marks nothing until a region has been chosen.
	 */
	demoLastUsed?: CloudRegionId;
	/**
	 * The cloud glyph on the sign-up trigger. Off by default: a button that opens a chooser holding
	 * an Install link is not a Cloud button, and the glyph would promise one.
	 */
	icon?: boolean;
}

const { flow = 'signup', id = 'tfd', nearest = 'us', demoLastUsed, icon = false } = Astro.props;

const signin = flow === 'signin';
// The triggers keep the shipped fallback href, so the draft is the site's markup, not a stand-in.
const fallback = `https://thingsboard.cloud/${signin ? 'login' : 'signup'}`;
// Where a region leads in the prototype: the faked pages under each flow's own address.
const PROTOTYPE = { signup: '/internal/flows/sign-up/', signin: '/internal/flows/sign-in/' };
---

<div class="tfd" data-tfd data-cloud-auth-scope data-demo-last={demoLastUsed}>
	<div class:list={['tfd__band', signin && 'tfd__band--signin']}>
		{
			signin && (
				<div class="tfd__header">
					<span class="tfd__logo">ThingsBoard</span>
					<span class="tfd__hctas">
						<a class="tfd__hbtn tfd__hbtn--outline" href={fallback} data-cloud-auth="signin">
							Sign in
						</a>
						<span class="tfd__hbtn tfd__hbtn--brand" aria-hidden="true">
							Try for free
						</span>
					</span>
				</div>
			)
		}
		<div class="tfd__copy">
			<p class="tfd__brand">ThingsBoard</p>
			<p class="tfd__headline">The all-in-one IoT platform</p>
			<p class="tfd__sub">
				Device management, data processing &amp; visualization for teams who build IoT for clients.
			</p>
			{
				!signin && (
					<div class="tfd__ctas">
						<a class="tfd__cta tfd__cta--brand" href={fallback} data-cloud-auth="signup">
							{icon && <Icon name="tabler:cloud-filled" aria-hidden="true" />}
							Try for free
						</a>
						<a class="tfd__cta tfd__cta--outline" href="/installations/">
							<Icon name="tabler:download" aria-hidden="true" />
							Install
						</a>
					</div>
				)
			}
		</div>
	</div>

	<CloudRegionDialog flow={flow} id={id} nearest={nearest} prototype={PROTOTYPE} />
</div>

<script>
	import { LAST_REGION, readLastRegion } from '@util/cloud-regions';

	// The draft's "Last visited" while this browser has nothing stored: announced, not stored, so
	// it does not come back as a real memory on the next load. The shipped dialog listens for the
	// same event its own store fires. Every instance on the page speaks, and the last one wins,
	// which on the sandbox pages is the only one.
	// A task later, so it runs after every hoisted script has registered its listeners, whatever
	// order the bundler emitted them in.
	setTimeout(() => {
		document.querySelectorAll<HTMLElement>('[data-tfd][data-demo-last]').forEach((root) => {
			if (readLastRegion()) return;
			window.dispatchEvent(new CustomEvent(LAST_REGION.event, { detail: root.dataset.demoLast }));
		});
	}, 0);
</script>

<style lang="scss">
	@use '../../styles/variables' as *;

	// `:where()` so the reset sits under the class rules below: `.tfd p` would outrank `.tfd__sub`
	// and friends and zero every margin they set, stacking the hero copy and the dialog together.
	.tfd {
		:where(p, h2) {
			margin: 0;
		}
	}

	// ---- The hero slice ---------------------------------------------------------------------
	// The black column, at the hero's own sizes: 44px buttons, 16px labels, the brand fill and
	// the 35% white rule on the outline, from `Hero.astro`'s split layout. The dialog's own
	// styles ship with `CloudRegionDialog`.
	.tfd__band {
		display: flex;
		align-items: center;
		padding: 56px 24px;
		background: #000;
		color: #fff;

		// In a phone frame the band is the phone's whole screen, so the sheet has a viewport to rise
		// into; the frame is sized from the document, and a 200px document would give the dialog
		// 200px to open in.
		:global(html[data-kv-frame]) & {
			min-height: 100svh;
			padding-top: 88px;
		}
	}

	// Sign-in: the header bar over the hero, at the header's own measures: a 40px outline "Sign in"
	// at 14px with the 35% white rule, and the brand "Try for free" beside it, inert here.
	.tfd__band--signin {
		flex-direction: column;
		align-items: stretch;
		gap: 40px;
		padding-top: 0;

		:global(html[data-kv-frame]) & {
			padding-top: 0;
		}
	}

	.tfd__header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		height: 64px;
	}

	.tfd__logo {
		font-size: 20px;
		font-weight: $font-weight-bold;
	}

	.tfd__hctas {
		display: flex;
		gap: 8px;
	}

	.tfd__hbtn {
		display: inline-flex;
		align-items: center;
		height: 40px;
		padding: 0 16px;
		border: 1px solid transparent;
		border-radius: 4px;
		font: inherit;
		font-size: 14px;
		color: #fff;
		text-decoration: none;
		white-space: nowrap;
	}

	.tfd__hbtn--outline {
		border-color: rgba(255, 255, 255, 0.35);
		background: transparent;
		cursor: pointer;
		transition:
			background-color $transition-base,
			border-color $transition-base;

		&:hover,
		&:focus-visible {
			background: rgba(255, 255, 255, 0.12);
			border-color: rgba(255, 255, 255, 0.55);
		}

		&:focus-visible {
			outline: 2px solid #fff;
			outline-offset: 3px;
		}
	}

	.tfd__hbtn--brand {
		background: $color-brand;
		font-weight: $font-weight-medium;
	}

	.tfd__copy {
		width: 100%;
		max-width: 560px;
		margin: 0 auto;
	}

	.tfd__brand {
		font-size: 32px;
		font-weight: $font-weight-bold;
		line-height: 1.15;
		color: rgba(255, 255, 255, 0.55);
	}

	.tfd__headline {
		font-size: 32px;
		font-weight: $font-weight-bold;
		line-height: 1.15;
		margin-bottom: 16px;
		text-wrap: balance;
	}

	.tfd__sub {
		font-size: 16px;
		line-height: 1.5;
		color: rgba(255, 255, 255, 0.85);
		margin-bottom: 24px;
	}

	.tfd__ctas {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.tfd__cta {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		height: 44px;
		padding: 0 16px;
		border: 1px solid transparent;
		border-radius: $radius-sm;
		font: inherit;
		font-size: 16px;
		line-height: 1;
		color: #fff;
		text-decoration: none;
		cursor: pointer;
		transition:
			background-color $transition-base,
			border-color $transition-base;

		[data-icon] {
			width: 18px;
			height: 18px;
		}

		&:focus-visible {
			outline: 2px solid #fff;
			outline-offset: 3px;
		}
	}

	.tfd__cta--brand {
		background: $color-brand;
		border-color: $color-brand;
		font-weight: $font-weight-bold;

		&:hover {
			background: color-mix(in srgb, #{$color-brand} 88%, #fff);
			border-color: color-mix(in srgb, #{$color-brand} 88%, #fff);
		}
	}

	.tfd__cta--outline {
		background: transparent;
		border-color: rgba(255, 255, 255, 0.35);
		font-weight: $font-weight-medium;

		&:hover {
			background: rgba(255, 255, 255, 0.14);
			border-color: rgba(255, 255, 255, 0.55);
		}
	}
</style>
